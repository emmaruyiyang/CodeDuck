{
  "name": "quackcode",
  "displayName": "QuackCode",
  "description": "An adorable duck companion for Claude Code - floats on top, bounces, quacks, and poops when waiting",
  "version": "0.1.0",
  "main": "dist/main.js",
  "homepage": "https://github.com/emmaruyiyang/CodeDuck",
  "author": "Ruyi Yang",
  "license": "MIT",
  "scripts": {
    "compile": "esbuild ./src/main.ts ./src/preload.ts --bundle --outdir=dist --format=cjs --platform=node --target=node20 --external:electron",
    "watch": "npm run compile -- --sourcemap --watch",
    "dev": "npm run compile && electron .",
    "build": "npm run compile -- --minify",
    "dist": "npm run build && electron-builder --mac && rm -rf release/mac release/mac-arm64 release/.icon-icns release/*.blockmap release/*.yml"
  },
  "build": {
    "appId": "com.quackcode.app",
    "productName": "QuackCode",
    "asar": false,
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "data/img/**/*",
      "data/sound/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${arch}.${ext}",
      "identity": null
    },
    "directories": {
      "output": "release"
    },
    "afterPack": "build/adhoc-sign.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^24.8.8",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.20.2",
    "typescript": "^5.3.3"
  }
}
